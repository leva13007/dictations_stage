# ElevenLabs API key (required)
ELEVEN_API_KEY=your_api_key_here

# Default voice ID — used when --voice flag is not passed
# If omitted, the first voice in the hardcoded voices map is used
# ELEVEN_VOICE_ID=G7ILShrCNLfmS0A37SXS

# ElevenLabs model (optional, default: eleven_flash_v2_5)
# ELEVEN_MODEL_ID=eleven_flash_v2_5

# Voice settings (optional)
# ELEVEN_SPEED=1.0
# ELEVEN_STABILITY=0.5
# ELEVEN_SIMILARITY_BOOST=0.8
